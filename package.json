{
  "name": "blog-elendia-net",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "serve": "node scripts/build.ts --serve",
    "content:sync": "node scripts/sync-content.ts",
    "content:new": "node scripts/new-post.ts",
    "build:dev": "node --env-file=.env.development --run build",
    "serve:dev": "node --env-file=.env.development --run serve",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@lumeland/core": "^1.0.5",
    "@lumeland/lume": "^4.0.3",
    "@lumeland/plugin-extract-date": "^1.0.0",
    "@lumeland/plugin-feed": "^1.0.0",
    "@lumeland/plugin-jsx": "^1.0.0",
    "@lumeland/plugin-markdown": "^1.0.0",
    "@lumeland/plugin-metas": "^1.0.0",
    "@lumeland/plugin-prism": "^1.0.0",
    "@lumeland/plugin-sass": "^1.0.1",
    "@lumeland/ssx": "^0.1.16",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-block-embed": "^0.0.3",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-named-code-blocks": "^0.2.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^0.6.0",
    "microcms-js-sdk": "^2.7.0",
    "prismjs": "^1.30.0",
    "tsx": "^4.23.15",
    "ventojs": "^2.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false
  }
}
