# ローカルでは .env.development にコピーして npm run serve:dev / build:dev で読み込む。
# Vercel では同名の環境変数をプロジェクトに設定する。

# ローカルで編集する記事リポジトリ。設定時は Git の取得より優先する。
CONTENT_DIR=

# 本番の記事リポジトリと取得対象。URL と公開用ブランチは決定後に設定する。
CONTENT_REPOSITORY=
CONTENT_REF=

# HTTPS の読み取りトークン。URL に埋め込まない。
# ユーザー名の指定方法は Git ホストに合わせる。
CONTENT_GIT_USERNAME=
CONTENT_GIT_TOKEN=

# 下書きの確認はローカルだけで有効にする。
CONTENT_INCLUDE_DRAFTS=false

# 記事移行中の microCMS。必要な場合だけ true にする。
MICROCMS_ENABLE=false
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
